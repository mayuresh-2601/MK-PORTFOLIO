# ─────────────────────────────────────────────────────────────
# Docker Compose only
# Copy this file to .env before running `docker compose up --build`.
# These are LOCAL development values — not your production credentials.
# ─────────────────────────────────────────────────────────────

# Password for the local MySQL container's root user.
DB_PASSWORD=portfolio_local_dev_password

# Database created inside the MySQL container.
DB_NAME=portfolio
