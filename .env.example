# -----------------------------------------------------------------------------
# Docker Compose - project-level environment (LOCAL ONLY)
#
# Copy this file to `.env` before running Docker:
#   Copy-Item .env.example .env
#
# Docker Compose reads this file for ${DB_PASSWORD} and ${DB_NAME}. The API
# container reads its own secrets from `server/.env` through `env_file`.
#
# Never put Gmail, JWT, admin, Cloudinary or Gemini secrets here. Those belong
# in `server/.env` locally and in Render's Environment tab in production.
# -----------------------------------------------------------------------------

# Root password for the local MySQL container. This is a local development
# value, not your TiDB production password.
DB_PASSWORD=portfolio_local_dev_password

# Database created inside the local MySQL container.
DB_NAME=portfolio
