# ---------------------------------------------------------------------------
# Portfolio client — environment template
# Copy to `.env.local` only if you need to override the defaults.
# ---------------------------------------------------------------------------

# Optional: explicit API origin (no trailing slash).
# Leave unset for same-origin requests — Vite proxies /api in development
# and preview, and Nginx proxies /api in Docker.
# VITE_API_BASE_URL=http://localhost:5000

# Optional: where the Vite /api proxy forwards requests.
# VITE_PROXY_TARGET=http://localhost:5000

# Split deployment (Vercel frontend + Render backend):
# Set this in Vercel → Project → Settings → Environment Variables, then
# redeploy. It is baked into the static build, so changing it requires a
# new deployment.
# VITE_API_BASE_URL=https://your-backend.onrender.com
