# -----------------------------------------------------------------------------
# Portfolio client - environment template
#
# Copy this file to `.env` for local Vite or Docker use:
#   Copy-Item .env.example .env
#
# SECURITY: Vite exposes every VITE_* variable to the browser and embeds it in
# the production bundle. Never put Gmail, JWT, admin, database, Cloudinary or
# Gemini secrets in this file. Server secrets belong in `server/.env` locally
# and in Render's Environment tab in production.
# -----------------------------------------------------------------------------

# Leave EMPTY for same-origin `/api` requests.
# - `npm run dev` and `npm run preview` proxy /api to VITE_PROXY_TARGET.
# - Nginx inside Docker proxies /api to the `server` container.
# - For the split Vercel + Render deployment, set this in
#   Vercel -> Project -> Settings -> Environment Variables, then redeploy.
#   Use the API origin only, with no trailing slash:
#   VITE_API_BASE_URL=https://mk-portfolio-api.onrender.com
# Changing this value requires a new build; it is baked into the static files.
VITE_API_BASE_URL=

# Local Vite dev/preview proxy target. Docker uses Nginx instead, so this
# value does not affect the container build.
VITE_PROXY_TARGET=http://localhost:5000
