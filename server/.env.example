# ─────────────────────────────────────────────────────────────
# Portfolio API — environment template
# Copy this file to .env and fill in real values. Never commit .env.
#
# Deployment targets:
#   API      → Render Web Service (rootDir: server)
#   Database → TiDB Cloud (MySQL compatible)
#   Frontend → Vercel (client/)
# ─────────────────────────────────────────────────────────────

# Server
# Render injects PORT automatically. Change only for local use.
PORT=5000
HOST=0.0.0.0

# Comma-separated list of allowed browser origins (no trailing slash).
# Local:  http://localhost:5173
# Vercel: https://your-project.vercel.app
# Never put a real Vercel preview URL here; use ALLOW_VERCEL_PREVIEWS.
CLIENT_URL=http://localhost:5173

# Set true only if you want every https://*.vercel.app preview deployment
# to be allowed by CORS. Exact production origins in CLIENT_URL are safer.
ALLOW_VERCEL_PREVIEWS=false

# Database — TiDB Cloud (port 4000, SSL required) or MySQL
# TiDB Cloud dashboard → Connect → copy the host, user and password.
# DB_PASSWORD may be empty for a local MySQL root account, but it must be
# defined (use `DB_PASSWORD=`).
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=portfolio

# TiDB Cloud requires TLS. Set false only for local MySQL/Docker.
DB_SSL=true

# Optional connection pool size (default 10; capped at 20)
DB_CONNECTION_LIMIT=10

# ─────────────────────────────────────────────────────────────
# AUTH — exactly ONE admin email/password pair
# ─────────────────────────────────────────────────────────────
# Generate a strong secret (32+ characters):
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Short sessions are safer. Use 30m, 12h, 1d, etc.
JWT_EXPIRES_IN=12h

ADMIN_EMAIL=your-real-admin@gmail.com

# OPTION A — plain-text password in the server-only .env (simple, as requested)
# Must be at least 12 characters and must not be a placeholder.
# Keep the single quotes if the password contains spaces, #, $, or quotes.
ADMIN_PASSWORD='replace-with-a-long-unique-password'

# OPTION B — bcrypt hash (recommended for production)
# Generate with: npm run hash-password -- "your-password"
# If both A and B are set, the bcrypt hash wins.
# Keep the hash in single quotes here. Docker Compose interpolates `$` in
# unquoted env-file values, which would corrupt a bcrypt hash. Single quotes
# make Compose pass the value literally. Dotenv strips the quotes for local
# `npm run dev`. Render's dashboard expects the raw hash WITHOUT quotes.
# ADMIN_PASSWORD_HASH='$2b$12$...'

# ─────────────────────────────────────────────────────────────
# EMAIL — Gmail notifications
# ─────────────────────────────────────────────────────────────
# The real Gmail account that sends contact-form notifications.
# Notifications go to ADMIN_EMAIL.
EMAIL_USER=your-real-email@gmail.com

# OPTION A — Gmail API over HTTPS (required on Render's FREE tier,
# which blocks outbound SMTP ports 25/465/587).
#
# One-time setup:
#   1. Google Cloud Console → enable Gmail API.
#   2. OAuth consent screen → External → add your Gmail as a test user.
#      Scopes: openid, email, https://www.googleapis.com/auth/gmail.send
#      Set publishing status to "In production" for a refresh token that
#      does not expire after 7 days (an unverified-app warning is expected).
#   3. Credentials → Create OAuth client ID → Desktop app.
#   4. Put the client ID and secret below, then run: npm run gmail:auth
# The script writes GMAIL_REFRESH_TOKEN and sets EMAIL_TRANSPORT=gmail-api.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# OPTION B — Gmail SMTP with a Google App Password
# Works locally and on paid hosting that allows SMTP.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification; spaces in the 16-character password are
# ignored by the server).
EMAIL_PASS=

# auto = Gmail API when configured, otherwise SMTP.
# gmail-api / smtp force a specific transport; none disables email.
EMAIL_TRANSPORT=auto

# ─────────────────────────────────────────────────────────────
# OPTIONAL INTEGRATIONS
# ─────────────────────────────────────────────────────────────
# Cloudinary (optional — uploads return 503 until configured)
CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_API_SECRET=your-cloudinary-api-secret

# Google Gemini (optional — AI endpoints return 502 until configured)
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
